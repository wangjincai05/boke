---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Layout/Header.astro";
import Footer from "../components/Layout/Footer.astro";
import ArticleList from "../components/Content/ArticleList.astro";
import TagCloud from "../components/Content/TagCloud.astro";
import { getCollection } from "astro:content";
import { getAllTags } from "../lib/search";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPosts = posts.filter((p) => p.data.featured).slice(0, 3);
const recentPosts = posts.slice(0, 6);
const tags = getAllTags(posts);
---

<BaseLayout>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <section class="border-b border-border bg-accent/30">
        <div class="mx-auto max-w-6xl px-4 py-20 text-center">
          <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl mb-4">
            我的博客
          </h1>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-8">
            记录技术心得，分享开发经验
          </p>
          <div class="flex items-center justify-center gap-6 text-sm text-muted-foreground">
            <span>{posts.length} 篇文章</span>
            <span class="text-border">|</span>
            <span>{tags.length} 个标签</span>
          </div>
        </div>
      </section>

      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_280px]">
          <div>
            {featuredPosts.length > 0 && (
              <section class="mb-12">
                <h2 class="text-lg font-semibold mb-6">精选文章</h2>
                <ArticleList posts={featuredPosts} />
              </section>
            )}

            <section>
              <h2 class="text-lg font-semibold mb-6">最新文章</h2>
              <ArticleList posts={recentPosts} />
              {posts.length > 6 && (
                <div class="mt-8 text-center">
                  <a
                    href="/blog"
                    class="inline-flex items-center rounded-lg border border-border bg-card px-6 py-2.5 text-sm font-medium text-card-foreground hover:bg-accent transition-colors"
                  >
                    查看全部 {posts.length} 篇文章
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
                      <path d="M5 12h14"/>
                      <path d="m12 5 7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              )}
            </section>
          </div>

          <aside class="space-y-8">
            <div class="rounded-lg border border-border bg-card p-6">
              <h3 class="text-sm font-semibold mb-4">标签</h3>
              <TagCloud tags={tags} />
            </div>
          </aside>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>