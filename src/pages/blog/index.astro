---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Layout/Header.astro";
import Footer from "../../components/Layout/Footer.astro";
import ArticleList from "../../components/Content/ArticleList.astro";
import TagCloud from "../../components/Content/TagCloud.astro";
import SearchBar from "../../components/Content/SearchBar.astro";
import Pagination from "../../components/Navigation/Pagination.astro";
import SeoHead from "../../components/SeoHead.astro";
import { getCollection } from "astro:content";
import { getAllTags } from "../../lib/search";

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = getAllTags(allPosts);

const page = Astro.url.searchParams.get("page");
const currentPage = page ? parseInt(page) : 1;
const perPage = 9;
const totalPages = Math.ceil(allPosts.length / perPage);
const posts = allPosts.slice((currentPage - 1) * perPage, currentPage * perPage);
---

<BaseLayout>
  <SeoHead
    title="文章列表"
    description="浏览所有技术文章，包括前端开发、后端技术、开发工具等"
  />
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="mb-8">
          <h1 class="text-3xl font-bold mb-4">文章列表</h1>
          <p class="text-muted-foreground mb-4">
            共 {allPosts.length} 篇文章
          </p>
          <div class="max-w-md">
            <SearchBar />
          </div>
        </div>

        <div class="grid gap-8 lg:grid-cols-[1fr_280px]">
          <div>
            {posts.length > 0 ? (
              <>
                <ArticleList posts={posts} />
                <Pagination
                  currentPage={currentPage}
                  totalPages={totalPages}
                  baseUrl="/blog"
                />
              </>
            ) : (
              <div class="text-center py-12 text-muted-foreground">
                <p>暂无文章</p>
              </div>
            )}
          </div>

          <aside class="space-y-8">
            <div class="rounded-lg border border-border bg-card p-6">
              <h3 class="text-sm font-semibold mb-4">标签</h3>
              <TagCloud tags={tags} />
            </div>
          </aside>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
