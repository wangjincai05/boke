---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Layout/Header.astro";
import Footer from "../../components/Layout/Footer.astro";
import ArticleList from "../../components/Content/ArticleList.astro";
import TagCloud from "../../components/Content/TagCloud.astro";
import SearchBar from "../../components/Content/SearchBar.astro";
import { getCollection } from "astro:content";
import { getAllTags } from "../../lib/search";

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = getAllTags(allPosts);

const page = Astro.url.searchParams.get("page");
const currentPage = page ? parseInt(page) : 1;
const perPage = 9;
const totalPages = Math.ceil(allPosts.length / perPage);
const posts = allPosts.slice((currentPage - 1) * perPage, currentPage * perPage);
---

<BaseLayout>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="mb-8">
          <h1 class="text-3xl font-bold mb-4">文章列表</h1>
          <div class="max-w-md">
            <SearchBar />
          </div>
        </div>

        <div class="grid gap-8 lg:grid-cols-[1fr_280px]">
          <div>
            <ArticleList posts={posts} />

            {totalPages > 1 && (
              <nav class="mt-8 flex items-center justify-center gap-2" aria-label="分页导航">
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <a
                    href={`/blog?page=${p}`}
                    class:list={[
                      "inline-flex h-9 w-9 items-center justify-center rounded-md text-sm font-medium transition-colors",
                      p === currentPage
                        ? "bg-primary text-primary-foreground"
                        : "border border-border bg-card text-card-foreground hover:bg-accent",
                    ]}
                  >
                    {p}
                  </a>
                ))}
              </nav>
            )}
          </div>

          <aside class="space-y-8">
            <div class="rounded-lg border border-border bg-card p-6">
              <h3 class="text-sm font-semibold mb-4">标签</h3>
              <TagCloud tags={tags} />
            </div>
          </aside>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>