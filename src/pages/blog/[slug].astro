---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Layout/Header.astro";
import Footer from "../../components/Layout/Footer.astro";
import Breadcrumb from "../../components/Navigation/Breadcrumb.astro";
import TableOfContents from "../../components/Navigation/TableOfContents.astro";
import RelatedPosts from "../../components/Content/RelatedPosts.astro";
import ArticleSeries from "../../components/Content/ArticleSeries.astro";
import Giscus from "../../components/Content/Giscus.astro";
import SeoHead from "../../components/SeoHead.astro";
import CodeCopyButton from "../../components/Content/CodeCopyButton.astro";
import { getCollection } from "astro:content";
import { extractHeadings } from "../../lib/toc";
import { getReadingStats, formatNumber } from "../../lib/readingStats";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
const { Content } = await post.render();

let headings = [];
try {
  headings = extractHeadings(post.body);
} catch (e) {
  console.error("Error extracting headings:", e);
}

const stats = getReadingStats(post.body);
---

<BaseLayout>
  <SeoHead
    title={post.data.title}
    description={post.data.description}
    type="article"
    publishedTime={post.data.date}
    tags={post.data.tags}
  />
  <CodeCopyButton />
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <div class="mx-auto max-w-7xl px-4 py-12">
        <div class="flex gap-12">
          <article class="flex-1 min-w-0">
            <Breadcrumb
              items={[
                { label: "首页", href: "/" },
                { label: "文章", href: "/blog" },
                { label: post.data.title },
              ]}
            />

            <div class="mb-8">
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.map((tag: string) => (
                  <a
                    href={`/tags/${tag.replace(/\//g, "-")}`}
                    class="inline-flex items-center rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary hover:bg-primary/20 transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
              <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-3">
                {post.data.title}
              </h1>
              <p class="text-lg text-muted-foreground mb-4">{post.data.description}</p>
              <div class="flex items-center gap-4 text-sm text-muted-foreground">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("zh-CN", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span class="text-border">|</span>
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1">
                    <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                  {formatNumber(stats.words)} 字
                </span>
                <span class="text-border">|</span>
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  阅读时间 {stats.readingTime} 分钟
                </span>
              </div>
            </div>

            <div class="lg:hidden">
              <TableOfContents headings={headings} />
            </div>

            <div class="article-content">
              <Content />
            </div>

            <ArticleSeries current={post} allPosts={allPosts} />

            <Giscus
              repo={siteConfig.giscus.repo}
              repoId={siteConfig.giscus.repoId}
              category={siteConfig.giscus.category}
              categoryId={siteConfig.giscus.categoryId}
              mapping={siteConfig.giscus.mapping}
              reactionsEnabled={siteConfig.giscus.reactionsEnabled}
              emitMetadata={siteConfig.giscus.emitMetadata}
              inputPosition={siteConfig.giscus.inputPosition}
              theme={siteConfig.giscus.theme}
              lang={siteConfig.giscus.lang}
              loading={siteConfig.giscus.loading}
            />

            <RelatedPosts current={post} all={allPosts} />
          </article>

          <div class="hidden lg:block">
            <TableOfContents headings={headings} />
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const articleContent = document.querySelector(".article-content");
    if (!articleContent) return;

    const headings = articleContent.querySelectorAll("h1, h2, h3, h4, h5, h6");

    headings.forEach((heading) => {
      if (!heading.id) {
        const slug = heading.textContent
          ?.toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
          .replace(/^-|-$/g, "");

        if (slug) {
          heading.id = slug;
          heading.classList.add("heading-anchor");
        }
      }
    });
  });
</script>

<style>
  .heading-anchor {
    position: relative;
    scroll-margin-top: 80px;
  }

  .heading-anchor:hover::before {
    content: "#";
    position: absolute;
    left: -1.5rem;
    color: var(--primary);
    opacity: 0.5;
  }
</style>
