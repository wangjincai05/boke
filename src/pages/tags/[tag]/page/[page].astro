---
import "../../../../styles/global.css";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Layout/Header.astro";
import Footer from "../../../../components/Layout/Footer.astro";
import ArticleList from "../../../../components/Content/ArticleList.astro";
import Breadcrumb from "../../../../components/Navigation/Breadcrumb.astro";
import Pagination from "../../../../components/Navigation/Pagination.astro";
import SeoHead from "../../../../components/SeoHead.astro";
import { getCollection } from "astro:content";

const { tag, page } = Astro.params;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tagSet = new Set<string>();

  for (const post of posts) {
    if (post.data.draft) continue;
    for (const t of post.data.tags) {
      tagSet.add(t);
    }
  }

  const perPage = 9;
  const paths = [];

  for (const t of Array.from(tagSet)) {
    const tagPosts = posts
      .filter((p) => !p.data.draft && p.data.tags.includes(t))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    const totalPages = Math.ceil(tagPosts.length / perPage);

    paths.push({
      params: { tag: t.replace(/\//g, "-"), page: "1" },
      props: {
        tag: t,
        allPosts: tagPosts,
        currentPage: 1,
        totalPages,
        perPage,
      },
    });

    for (let i = 2; i <= totalPages; i++) {
      paths.push({
        params: { tag: t.replace(/\//g, "-"), page: String(i) },
        props: {
          tag: t,
          allPosts: tagPosts,
          currentPage: i,
          totalPages,
          perPage,
        },
      });
    }
  }

  return paths;
}

const currentPage = Astro.props.currentPage;
const totalPages = Astro.props.totalPages;
const allPosts = Astro.props.allPosts;
const perPage = Astro.props.perPage;

const startIndex = (currentPage - 1) * perPage;
const posts = allPosts.slice(startIndex, startIndex + perPage);
---

<BaseLayout>
  <SeoHead
    title={`标签：${tag}`}
    description={`浏览所有带有「${tag}」标签的文章，共 ${allPosts.length} 篇`}
  />
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <Breadcrumb
          items={[
            { label: "首页", href: "/" },
            { label: "标签", href: "/tags" },
            { label: tag },
          ]}
        />

        <h1 class="text-3xl font-bold mb-2">
          标签：{tag}
        </h1>
        <p class="text-muted-foreground mb-8">
          {currentPage > 1 ? `第 ${currentPage} / ${totalPages} 页，` : ""}
          共 {allPosts.length} 篇文章
        </p>

        {posts.length > 0 ? (
          <>
            <ArticleList posts={posts} />
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              baseUrl={`/tags/${tag.replace(/\//g, "-")}`}
            />
          </>
        ) : (
          <div class="text-center py-12 text-muted-foreground">
            <p>暂无文章</p>
          </div>
        )}
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
