---
export interface Props {
  placeholder?: string;
}
const { placeholder = "搜索文章..." } = Astro.props;
---

<div class="relative">
  <input
    type="text"
    id="search-input"
    placeholder={placeholder}
    class="w-full rounded-lg border border-border bg-background px-4 py-2.5 pl-10 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-colors"
  />
  <svg
    class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
  </svg>
</div>

<script>
  import { getSearchIndex } from "../../lib/search";

  let index: any[] = [];

  async function init() {
    index = await getSearchIndex();
  }

  document.getElementById("search-input")?.addEventListener("input", (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    if (!index.length) return;

    const results = index.filter((post: any) => {
      return (
        post.title.toLowerCase().includes(query) ||
        post.description.toLowerCase().includes(query) ||
        post.tags?.some((t: string) => t.toLowerCase().includes(query)) ||
        post.content?.toLowerCase().includes(query)
      );
    });

    showResults(results.slice(0, 10), query);
  });

  function showResults(results: any[], query: string) {
    let container = document.getElementById("search-results");
    if (!container) {
      container = document.createElement("div");
      container.id = "search-results";
      container.className = "absolute top-full mt-2 w-full rounded-lg border border-border bg-card shadow-lg max-h-80 overflow-y-auto z-50";
      document.querySelector(".relative")?.appendChild(container);
    }

    if (!query) {
      container.innerHTML = "";
      return;
    }

    if (results.length === 0) {
      container.innerHTML = '<p class="px-4 py-3 text-sm text-muted-foreground">未找到结果</p>';
      return;
    }

    container.innerHTML = results
      .map(
        (r) => `
      <a href="/blog/${r.slug}" class="block px-4 py-3 hover:bg-accent transition-colors border-b border-border last:border-0">
        <div class="text-sm font-medium text-card-foreground">${highlight(r.title, query)}</div>
        <div class="text-xs text-muted-foreground mt-0.5 line-clamp-1">${highlight(r.description, query)}</div>
      </a>
    `
      )
      .join("");
  }

  function highlight(text: string, query: string) {
    if (!query) return text;
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi");
    return text.replace(regex, '<mark class="bg-yellow-200 dark:bg-yellow-800 rounded px-0.5">$1</mark>');
  }

  init();
</script>