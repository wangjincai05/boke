---
export interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑导航" class="flex items-center gap-1.5 text-sm text-muted-foreground mb-6">
  {items.map((item, i) => (
    <>
      {i > 0 && (
        <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      )}
      {item.href ? (
        <a href={item.href} class="hover:text-foreground transition-colors">{item.label}</a>
      ) : (
        <span class="text-foreground font-medium">{item.label}</span>
      )}
    </>
  ))}
</nav>